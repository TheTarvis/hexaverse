func TestService_Create(t *testing.T) {
	ctrl := gomock.NewController(t)
	defer ctrl.Finish()

	dao := NewMockDao(ctrl)
	dao.EXPECT().Save(gomock.Any(), gomock.Any()).DoAndReturn(func(_ context.Context, {{singular}} {{Singular}}) error {
		assert.Equal(t, "owner-1", {{singular}}.OwnerId)
		assert.Equal(t, "thing", {{singular}}.Name)
		assert.NotEmpty(t, {{singular}}.Id)
		return nil
	})

	svc := NewServiceWithDao(dao)
	created, err := svc.Create(context.Background(), "owner-1", CreateRequest{Name: "thing"})
	require.NoError(t, err)
	assert.Equal(t, "thing", created.Name)
}

