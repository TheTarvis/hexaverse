# Environment Configuration
ENV=LOCAL

# API Configuration
SERVICE_NAME=hexaverse-api
VERSION=__dev__
PORT=9010
FRONTEND_URL=http://localhost:3010

# Google Cloud Pub/Sub Configuration (required)
GCP_PROJECT_ID=your-gcp-project-id
PUBSUB_TOPIC_PREFIX=hexaverse

# Google OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID=client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=client_secret_here

# Anthropic (LLM)
ANTHROPIC_API_KEY=anthropic_api_key

# Resend (platform-managed email sender — Flywheel-branded "Email" provider)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_SENDER=Hexaverse <pipelines@hexaverse.io>

# For local development with Pub/Sub emulator
# Uncomment and set to use local emulator instead of real Pub/Sub
# PUBSUB_EMULATOR_HOST=localhost:8096