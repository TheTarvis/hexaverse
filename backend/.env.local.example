# Environment Configuration
ENV=LOCAL

# API Configuration
SERVICE_NAME=hexaverse-api
VERSION=__dev__
PORT=9010
FRONTEND_URL=http://localhost:3000

# Firebase Configuration (Local Dev Emulator)
FIREBASE_PROJECT_ID=hexaverse-emulator
FIREBASE_AUTH_EMULATOR_HOST=localhost:9109

# Firestore (Local Dev Emulator)
FIRESTORE_PROJECT_ID=hexaverse-emulator
FIRESTORE_EMULATOR_HOST=127.0.0.1:8090

# Pub/Sub (Local Dev Emulator)
PUBSUB_EMULATOR_HOST=localhost:8096

# GCS Storage: Uses real hexaverse-imports-dev bucket
# RECOMMENDED: Create a service account key (never expires):
#   gcloud iam service-accounts keys create ~/hexaverse-game-dev-sa.json \
#     --iam-account=hexaverse-backend@hexaverse-game-dev.iam.gserviceaccount.com
# Then uncomment and update the path below:
# GOOGLE_APPLICATION_CREDENTIALS=/Users/<your-username>/hexaverse-game-dev-sa.json
#
# ALTERNATIVE: gcloud auth application-default login (tokens expire after ~1 hour)
# E2E_TEST_BUCKET=hexaverse-imports-dev  # Optional override for tests

# GCP Configuration
GCP_PROJECT_ID=hexaverse-emulator

# Google OAuth Configuration
# Set these in your IDE run configuration or shell environment
# For GitLab CI, these are set as CI/CD variables
# GOOGLE_OAUTH_CLIENT_ID=<your-client-id>
# GOOGLE_OAUTH_CLIENT_SECRET=<your-client-secret>

# GCS Managed Bucket Configuration (for file uploads/downloads)
# These have sensible defaults but can be overridden
# IMPORT_BUCKET=hexaverse-imports-dev
# EXPORT_BUCKET=hexaverse-exports-dev
# GCS_SIGNING_SA=hexaverse-backend@hexaverse.iam.gserviceaccount.com
