# Environment Configuration
ENV=TEST

# Disable rate limiting for e2e tests (tests hammer endpoints from loopback)
DISABLE_RATE_LIMITING=true

# API Configuration
SERVICE_NAME=flywheel-api
VERSION=__dev__
PORT=9001
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info
GIN_MODE=release

# Firebase Configuration (Test Emulator)
FIREBASE_PROJECT_ID=flywheel-emulator
FIREBASE_AUTH_EMULATOR_HOST=localhost:10099

# Firestore (Test Emulator)
FIRESTORE_PROJECT_ID=flywheel-emulator
FIRESTORE_EMULATOR_HOST=localhost:9090

# Pub/Sub (Test Emulator)
PUBSUB_EMULATOR_HOST=localhost:9096

# GCP Configuration
GCP_PROJECT_ID=flywheel-emulator

# GCS Storage: Uses same dev buckets as local development
# RECOMMENDED: Create a service account key (never expires):
#   gcloud iam service-accounts keys create ~/flywheel-dev-sa.json \
#     --iam-account=flywheel-backend@flywheel-etl-dev.iam.gserviceaccount.com
# Then uncomment and update the path below:
# GOOGLE_APPLICATION_CREDENTIALS=/Users/<your-username>/flywheel-dev-sa.json
#
# ALTERNATIVE: gcloud auth application-default login (tokens expire after ~1 hour)

# GCS Managed Buckets: Use dev buckets for tests (isolated by path prefix)
# Sources read from IMPORT_BUCKET, sinks write to EXPORT_BUCKET
IMPORT_BUCKET=flywheel-imports-dev
EXPORT_BUCKET=flywheel-exports-dev
GCS_SIGNING_SA=flywheel-backend@flywheel-etl-dev.iam.gserviceaccount.com

# Google OAuth Configuration
# Set these in your IDE run configuration or shell environment
# For GitLab CI, these are set as CI/CD variables
# GOOGLE_OAUTH_CLIENT_ID=<your-client-id>
# GOOGLE_OAUTH_CLIENT_SECRET=<your-client-secret>
