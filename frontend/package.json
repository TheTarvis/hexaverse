{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && ./scripts/tsc-check.sh",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "e2e": "bash ../scripts/dev/with-test-emulators.sh 'cd frontend && npx playwright test'",
    "e2e:headed": "bash ../scripts/dev/with-test-emulators.sh 'cd frontend && npx playwright test --headed'",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
