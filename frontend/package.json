{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "storybook": "set -a && . ../.ports.env && set +a && storybook dev --host 127.0.0.1 -p $PORT_STORYBOOK --no-open --disable-telemetry",
    "build-storybook": "storybook build --output-dir .storybook/storybook-static --disable-telemetry",
    "dev": "set -a && . ../.ports.env && set +a && python3 ../harness/ports.py check --only frontend && next dev --turbopack -p 20200 --port $PORT_FRONTEND",
    "build": "next build",
    "start": "set -a && . ../.ports.env && set +a && next start --port $PORT_FRONTEND",
    "lint": "eslint . && ./scripts/tsc-check.sh",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "e2e": "bash ../scripts/dev/with-test-emulators.sh 'cd frontend && npx playwright test'",
    "e2e:headed": "bash ../scripts/dev/with-test-emulators.sh 'cd frontend && npx playwright test --headed'",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "users": "vite-node e2e/cli/users.ts --"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.11.0",
    "@tanstack/react-query": "^5.84.1",
    "@tanstack/react-query-devtools": "^5.84.1",
    "@tiptap/core": "^3.20.0",
    "@tiptap/extension-document": "^3.20.0",
    "@tiptap/extension-hard-break": "^3.20.0",
    "@tiptap/extension-paragraph": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-text": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/suggestion": "^3.20.0",
    "@vercel/analytics": "^1.6.1",
    "@xyflow/react": "^12.10.0",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.16",
    "elkjs": "^0.11.0",
    "firebase": "^12.15.0",
    "framer-motion": "^12.23.12",
    "lodash": "^4.17.23",
    "marked": "^17.0.1",
    "next": "^15.5.27",
    "papaparse": "^5.5.3",
    "react": "^19.2.3",
    "react-compare-image": "^3.5.13",
    "react-dom": "^19.2.3",
    "react-force-graph-2d": "^1.29.1",
    "react-hook-form": "^7.62.0",
    "reactflow": "^11.11.4",
    "sonner": "^2.0.7",
    "three": "^0.185.1",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.54.2",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-a11y": "^9.1.1",
    "@storybook/addon-docs": "^9.1.1",
    "@storybook/addon-onboarding": "^9.1.1",
    "@storybook/addon-vitest": "^9.1.1",
    "@storybook/nextjs-vite": "^9.1.21",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/lodash": "^4.17.23",
    "@types/marked": "^5.0.2",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.4.6",
    "jsdom": "^26.1.0",
    "jsdom-testing-mocks": "^1.16.0",
    "knip": "^5.81.0",
    "playwright": "^1.54.2",
    "storybook": "^9.1.21",
    "tailwindcss": "^4.1.11",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
