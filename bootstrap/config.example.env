# Bootstrap config for a new project.
#
# Two ways to fill this in:
#   1. Run `/onboard` — Claude walks you through every value, runs gcloud /
#      firebase commands to create the GCP + Firebase projects, and pulls the
#      Firebase SDK config back into this file automatically.
#   2. Copy this file to bootstrap/config.env, fill it in by hand, then run
#      `bash bootstrap/init.sh` to substitute placeholders + write
#      frontend/.env.local.
#
# Both bootstrap/config.env and frontend/.env.local are gitignored.

# ---------------------------------------------------------------------------
# Project identity
# ---------------------------------------------------------------------------
# PROJECT_SLUG is used as:
#   - Go module name (backend/go.mod → "module <slug>")
#   - Cloud Run / Vercel / GCS service names ("<slug>-backend", etc.)
#   - Pub/Sub topics, Postgres test DB, Artifact Registry repo
# Use lowercase letters and digits only. No hyphens or underscores —
# Go module names with hyphens work but Postgres DB names with hyphens don't.
PROJECT_SLUG=volt

# PROJECT_NAME is the human-readable display name shown in the UI
# (page titles, sidebar header, login screen).
PROJECT_NAME=Volt

# ---------------------------------------------------------------------------
# GCP
# ---------------------------------------------------------------------------
# Project IDs (one per environment). Globally unique. 6–30 chars, lowercase
# letters / digits / hyphens, must start with a letter, must end with a
# letter or digit. setup-gcp.sh checks availability before creating.
GCP_PROJECT_DEV=
GCP_PROJECT_PROD=

# Billing account ID, format XXXXXX-XXXXXX-XXXXXX. List yours with:
#   gcloud beta billing accounts list
BILLING_ACCOUNT=

# Region for Firestore + Cloud Run. us-central1 is the cheapest and matches
# the Firestore default; change only if you have a specific reason.
REGION=us-central1

# ---------------------------------------------------------------------------
# Public domains
# ---------------------------------------------------------------------------
# Used in CORS origins, OAuth redirect allow-lists, Firebase Auth domain.
# Bare hostname (no scheme).
PROD_DOMAIN=
DEV_DOMAIN=

# ---------------------------------------------------------------------------
# Firebase config — auto-populated by setup-gcp.sh
# ---------------------------------------------------------------------------
# These come from `firebase apps:sdkconfig` after the web app is created.
# DEV values get written to frontend/.env.local for local dev.
# PROD values are kept here so you can paste them into Vercel when deploying.
# All Firebase web-app config keys are public — safe in source control —
# but we keep config.env gitignored as a defense-in-depth habit.

FIREBASE_API_KEY_DEV=
FIREBASE_AUTH_DOMAIN_DEV=
FIREBASE_PROJECT_ID_DEV=
FIREBASE_STORAGE_BUCKET_DEV=
FIREBASE_MESSAGING_SENDER_ID_DEV=
FIREBASE_APP_ID_DEV=

FIREBASE_API_KEY_PROD=
FIREBASE_AUTH_DOMAIN_PROD=
FIREBASE_PROJECT_ID_PROD=
FIREBASE_STORAGE_BUCKET_PROD=
FIREBASE_MESSAGING_SENDER_ID_PROD=
FIREBASE_APP_ID_PROD=

# ---------------------------------------------------------------------------
# Local dev API URL (frontend → backend)
# ---------------------------------------------------------------------------
API_URL_LOCAL=http://localhost:9010
