# Local-dev environment for the claude-agent service.
# Copy to .env (gitignored) and fill in.

# --- Server ---
# 8100 locally — 8080 collides with Flywheel's dev Firestore emulator (Cloud Run still uses 8080 internally).
PORT=8100
ENVIRONMENT=development         # development | production
LOG_LEVEL=INFO

# Comma-separated list of frontend origins allowed to call /chat.
# Add your dev frontend (3000) and any preview/prod hosts.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Anthropic ---
# Get one at https://console.anthropic.com — the agent makes one Claude call
# per turn (plus one fast Haiku call for the streaming acknowledgment).
ANTHROPIC_API_KEY=

# --- Firebase ---
# Project ID for the dev environment. Without this, /chat returns 401 because
# token verification can't run; /health stays up so the process boots cleanly.
FIREBASE_PROJECT_ID=hexaverse-game-dev

# Set to "localhost:9109" when running the local Firebase auth emulator.
# Leave empty to verify real Firebase tokens (Cloud Run uses ADC).
FIREBASE_AUTH_EMULATOR_HOST=

# --- Backend (Go service) ---
# Tools call this with the user's Firebase token attached as a Bearer.
BACKEND_API_URL=http://localhost:9010

# --- Rate limiting ---
# Per-user fixed-window limit on /chat. Each request hits the Anthropic API,
# so this is mainly a cost-control safety net.
RATE_LIMIT_REQUESTS_PER_MINUTE=20
DISABLE_RATE_LIMITING=false     # true for tests / e2e runs

# --- Agent ---
AGENT_MAX_TOKENS=4096
AGENT_DEFAULT_MODEL=claude-sonnet-4-6
AGENT_ACK_MODEL=claude-haiku-4-5-20251001

# --- GCP (Cloud Logging context) ---
GCP_PROJECT_ID=hexaverse-game-dev
GCP_REGION=us-central1
